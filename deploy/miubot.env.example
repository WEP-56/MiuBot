# Miubot 生产环境变量
#
# 安装位置：/etc/miubot/miubot.env，权限必须是 0600（里面有口令/令牌路径语义）。
#   install -d -m 700 /etc/miubot
#   install -m 600 deploy/miubot.env.example /etc/miubot/miubot.env

# ── 监听 ──────────────────────────────────────────────────────────────
# 只监听回环：TLS 与公网入口交给 nginx / Caddy。
MIUBOT_HOST=127.0.0.1
MIUBOT_PORT=8787

# ── 数据目录 ──────────────────────────────────────────────────────────
# config.json（QQ AppSecret + 各 Provider apiKey 明文）、会话、插件数据、口令散列都在这里。
# 默认是仓库内的 apps/server/.miubot；生产必须挪到独立卷。
MIUBOT_DATA_DIR=/var/lib/miubot

# ── 对外域名 ──────────────────────────────────────────────────────────
# 应用按 Host 校验（防 DNS rebinding），必须列出真实域名；不支持通配符。
# 反代要 `proxy_set_header Host $host`，**不要**改写成 127.0.0.1:8787。
MIUBOT_ALLOWED_HOSTS=example.com

# 同源部署时 Origin 由上面的域名自动推导；只有前端单独挂在别的 origin 时才需要：
# MIUBOT_ALLOWED_ORIGINS=https://miubot.example.net

# ── 会话 Cookie ───────────────────────────────────────────────────────
# 配了 MIUBOT_ALLOWED_HOSTS 时默认已开启 Secure（HTTPS 部署）。纯 HTTP 内网部署要显式关掉，
# 否则浏览器不保存 Cookie，登录会变成无限重定向。
# MIUBOT_COOKIE_SECURE=0

# ── 管理员口令（二选一，都不配则首启动生成并打印到日志）────────────────
# 散列形式（推荐：环境变量里不出现明文）：
#   node -e 'import("./apps/server/src/auth.ts").then(async (m) => console.log(await m.hashPassword(process.argv[1])))' '你的口令'
# MIUBOT_PASSWORD_HASH=scrypt$16384$8$1$<saltHex>$<hashHex>
# 明文形式（会被就地散列，不落盘；适合容器 secrets 直接注入）：
# MIUBOT_ADMIN_PASSWORD=

# ── 工作台产物 ────────────────────────────────────────────────────────
# 默认 apps/web/dist（由 npm run build --workspace=@miubot/web 生成）。
# MIUBOT_WEB_DIST=/opt/miubot/apps/web/dist

# ── 自动化脚本令牌 ────────────────────────────────────────────────────
# 不配则读取/生成 $MIUBOT_DATA_DIR/api-token。令牌只能走请求头
# （Authorization: Bearer / X-Miubot-Token），不能换浏览器 Cookie。
# MIUBOT_AUTH_TOKEN=

# ── 版本与更新检查 ────────────────────────────────────────────────────
# 版本来源优先级：MIUBOT_VERSION → 仓库根 VERSION 文件（发布包自带）→ package.json。
# 用发布包（miubot-vX.Y.Z.tar.gz）解压部署时不用设，包里的 VERSION 已经是对的。
# MIUBOT_VERSION=0.2.0

# 更新检查只问 GitHub 公开 API（每 6 小时一次，只带 User-Agent），不自动升级。
# 设为 0 完全不出站；fork 后想检查自己的仓库就改 MIUBOT_UPDATE_REPO。
# MIUBOT_UPDATE_CHECK=0
# MIUBOT_UPDATE_REPO=owner/repo

# ── 入站白名单与工具策略 ──────────────────────────────────────────────
# 只有列出的群 / 私聊能触发 Agent；留空 = 不限制。公网部署务必填上。
# 格式：group:<群 ID> 或 c2c:<用户 ID>，逗号分隔。
# MIUBOT_ALLOWED_PEERS=group:1234567890

# 1 = 整体禁用文件与命令类工具（read/bash/powershell/edit/write/grep/find/ls）。
# MIUBOT_DISABLE_NATIVE_TOOLS=1
