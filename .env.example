# 复制为 .env 后按需修改：cp .env.example .env
# compose.yaml 会自动读取仓库根目录的 .env。

# ── 对外域名 ────────────────────────────────────────────────────────────
# 用 `docker compose --profile tls up -d` 时必填：Caddy 会为它自动申请/续期证书。
# 自己已有反代（nginx / Traefik / Cloudflare）时也填它——应用按这个值做 Host 校验。
# 留空 = 只接受回环访问，只能在本机 curl 或由同机反代带上正确 Host 头访问。
MIUBOT_DOMAIN=

# ── 端口发布 ────────────────────────────────────────────────────────────
# 默认只绑回环，交给同机反代。想直连 IP 访问（无 TLS，不推荐）改成 0.0.0.0。
MIUBOT_BIND=127.0.0.1
MIUBOT_PUBLISH_PORT=8787

# ── 镜像 ────────────────────────────────────────────────────────────────
# 默认本地构建（docker compose up -d --build）。
# 想用官方发布镜像（不用在机器上构建，ARM 机器也推荐）：
#   MIUBOT_IMAGE=ghcr.io/wep-56/miubot:latest
# 然后 `docker compose pull && docker compose up -d`。
# MIUBOT_IMAGE=ghcr.io/wep-56/miubot:latest

# ── 管理员口令 ──────────────────────────────────────────────────────────
# 留空 = 首次启动自动生成并打印到 `docker compose logs miubot`。
# 想自己定，先生成散列（仓库根目录）：
#   npm run hash-password --workspace=@miubot/server -- '你的口令'
MIUBOT_PASSWORD_HASH=
# 也可以直接给明文（启动时就地散列，不落盘；适合从 secrets 注入）。
MIUBOT_ADMIN_PASSWORD=

# ── 可选 ────────────────────────────────────────────────────────────────
# 纯 HTTP 内网部署时设为 0，否则浏览器不保存会话 Cookie（登录会无限重定向）。
# MIUBOT_COOKIE_SECURE=0
# 前端单独挂在别的 origin 时才需要：
# MIUBOT_ALLOWED_ORIGINS=

# 时区：影响运行日志时间与「主动行为」的静默时段判断。
TZ=Asia/Shanghai

# 内置更新检查：留空 = 开启（每 6 小时问一次 GitHub 公开 API，只带 User-Agent，不带任何标识）；
# 设为 0 = 完全不出站，工作台显示「更新检查已关闭」。
# MIUBOT_UPDATE_CHECK=0
# fork 之后想检查自己的仓库：
# MIUBOT_UPDATE_REPO=owner/repo
