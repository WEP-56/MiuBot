{
	"name": "miubot",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"workspaces": ["packages/*", "apps/*"],
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"generate:model-data": "node packages/provider/scripts/generate-models.ts --strict --data-only"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/cross-spawn": "6.0.6",
		"@types/node": "22.19.19",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	}
}
